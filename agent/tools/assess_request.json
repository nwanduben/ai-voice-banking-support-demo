{
  "type": "webhook",
  "name": "assess_request",
  "description": "Call as soon as you understand what the caller wants, and again whenever the topic changes. Returns the official risk level, whether identity verification is needed, and whether you must hand over to a human. Always follow its result.",
  "response_timeout_secs": 10,
  "api_schema": {
    "url": "https://qr4v3tgj.rcld.app/webhook/entin/assess_request",
    "method": "POST",
    "request_headers": {
      "Authorization": {
        "secret_id": "REPLACE_WITH_ELEVENLABS_SECRET_ID"
      }
    },
    "request_body_schema": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id",
          "description": "Conversation id (injected)"
        },
        "intent": {
          "type": "string",
          "description": "The caller's intent",
          "enum": [
            "FAQ_GENERAL",
            "BRANCH_SERVICE_INFO",
            "TRANSFER_FAILED",
            "TRANSFER_DEBITED_NOT_RECEIVED",
            "TRANSACTION_PENDING",
            "REVERSAL_STATUS",
            "UNAUTHORIZED_TRANSACTION",
            "ATM_CASH_DISPUTE",
            "POS_DISPUTE",
            "CARD_DECLINED",
            "CARD_LOST_STOLEN",
            "MOBILE_LOGIN_ISSUE",
            "DIGITAL_PROFILE_LOCKED",
            "CREDENTIAL_RESET_GUIDANCE",
            "OTP_NOT_RECEIVED",
            "COMPLAINT_TICKET_STATUS",
            "ACCOUNT_RESTRICTION",
            "SUSPECTED_FRAUD_SCAM",
            "HUMAN_AGENT_REQUEST",
            "SENSITIVE_INFO_DISCLOSED",
            "VERIFICATION_FAILED",
            "PROHIBITED_REQUEST",
            "OUT_OF_SCOPE_OR_UNCLEAR"
          ]
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "signal",
            "enum": [
              "customer_denies_authorisation",
              "social_engineering_suspected",
              "vulnerable_customer",
              "repeat_contact",
              "prompt_injection"
            ]
          },
          "description": "Risk signals you heard. Empty if none."
        },
        "amount_naira": {
          "type": "number",
          "description": "Amount in naira the caller mentioned, if any"
        }
      },
      "required": [
        "conversation_id",
        "intent"
      ]
    }
  }
}
