{
  "type": "webhook",
  "name": "get_ticket_status",
  "description": "Check an existing complaint or dispute. Ask the caller to read the reference slowly, e.g. T K T 1 0 4 2 3 3.",
  "response_timeout_secs": 10,
  "api_schema": {
    "url": "https://qr4v3tgj.rcld.app/webhook/entin/get_ticket_status",
    "method": "POST",
    "request_headers": {
      "Authorization": {
        "secret_id": "REPLACE_WITH_ELEVENLABS_SECRET_ID"
      }
    },
    "request_body_schema": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id",
          "description": "Conversation id (injected)"
        },
        "reference": {
          "type": "string",
          "description": "Reference like TKT-104233 or DSP-200017"
        }
      },
      "required": [
        "conversation_id",
        "reference"
      ]
    }
  }
}
