{
  "type": "webhook",
  "name": "get_card_status",
  "description": "Check card status and the reason for the latest declined payment. Read the 'say' text; never guess a decline reason.",
  "response_timeout_secs": 10,
  "api_schema": {
    "url": "https://qr4v3tgj.rcld.app/webhook/entin/get_card_status",
    "method": "POST",
    "request_headers": {
      "Authorization": {
        "secret_id": "REPLACE_WITH_ELEVENLABS_SECRET_ID"
      }
    },
    "request_body_schema": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id",
          "description": "Conversation id (injected)"
        },
        "card_last4": {
          "type": "string",
          "description": "Last 4 digits of the card, if the caller has more than one"
        }
      },
      "required": [
        "conversation_id"
      ]
    }
  }
}
