{
  "type": "webhook",
  "name": "get_transaction_status",
  "description": "Get status, reversal information and the recommended next step for one transaction found with find_transactions.",
  "response_timeout_secs": 10,
  "api_schema": {
    "url": "https://qr4v3tgj.rcld.app/webhook/entin/get_transaction_status",
    "method": "POST",
    "request_headers": {
      "Authorization": {
        "secret_id": "REPLACE_WITH_ELEVENLABS_SECRET_ID"
      }
    },
    "request_body_schema": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id",
          "description": "Conversation id (injected)"
        },
        "txn_id": {
          "type": "string",
          "description": "Transaction id from find_transactions, e.g. TXN-000101"
        }
      },
      "required": [
        "conversation_id",
        "txn_id"
      ]
    }
  }
}
