{
  "type": "webhook",
  "name": "find_transactions",
  "description": "Find the transaction the caller is describing when they don't know the reference. Use approximate amount, date range and channel. If it returns several matches or AMBIGUOUS_MATCH, ask one narrowing question.",
  "response_timeout_secs": 10,
  "api_schema": {
    "url": "https://qr4v3tgj.rcld.app/webhook/entin/find_transactions",
    "method": "POST",
    "request_headers": {
      "Authorization": {
        "secret_id": "REPLACE_WITH_ELEVENLABS_SECRET_ID"
      }
    },
    "request_body_schema": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id",
          "description": "Conversation id (injected)"
        },
        "date_from": {
          "type": "string",
          "description": "Start date YYYY-MM-DD (default 7 days ago)"
        },
        "date_to": {
          "type": "string",
          "description": "End date YYYY-MM-DD"
        },
        "amount_naira_approx": {
          "type": "number",
          "description": "Approximate amount in naira"
        },
        "channel": {
          "type": "string",
          "description": "Channel",
          "enum": [
            "transfer",
            "pos",
            "atm",
            "card_online",
            "ussd"
          ]
        },
        "direction": {
          "type": "string",
          "description": "debit (money out, default) or credit (money in)",
          "enum": [
            "debit",
            "credit"
          ]
        }
      },
      "required": [
        "conversation_id"
      ]
    }
  }
}
